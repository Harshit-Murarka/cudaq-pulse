"""Capabilities this cudaq-pulse build was configured with (generated by CMake)."""

PACKAGE_VERSION = "@CUDAQ_PULSE_PACKAGE_VERSION@"
LLVM_VERSION = "@LLVM_PACKAGE_VERSION@"

GPU_RUNTIME_ENABLED = @CUDAQ_PULSE_GPU_RUNTIME_ENABLED_PY@
"""Whether the cuDensityMat GPU runtime was built into this package."""

GPU_RUNTIME_LIBRARIES: dict[int, str] = @CUDAQ_PULSE_GPU_RUNTIME_LIBRARIES_PY@
"""Bundled GPU runtime per CUDA major, relative to the package directory."""

CUDENSITYMAT_VERSIONS: dict[int, str] = @CUDAQ_PULSE_CUDENSITYMAT_VERSIONS_PY@
CUDA_VERSIONS: dict[int, str] = @CUDAQ_PULSE_CUDA_VERSIONS_PY@
"""cuDensityMat and CUDA runtime versions each GPU runtime was compiled against."""
